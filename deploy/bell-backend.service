[Unit]
Description=School bell Django API
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=bell
Group=bell
WorkingDirectory=/opt/bell/backend
EnvironmentFile=/etc/bell/dzwonek.env
Environment=BELL_DATABASE_PATH=/var/lib/bell/db.sqlite3
ExecStartPre=/usr/local/lib/bell/wait-for-time-sync.sh
ExecStart=/opt/bell/backend/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8010 backend.wsgi:application
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bell

[Install]
WantedBy=multi-user.target
