[Unit]
Description=School bell controller and web application
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target bell-backend.service
Requires=bell-backend.service

[Service]
Type=simple
User=bell
Group=bell
SupplementaryGroups=gpio i2c
WorkingDirectory=/opt/bell/site
EnvironmentFile=/etc/bell/dzwonek.env
Environment=BELL_DATABASE_PATH=/var/lib/bell/db.sqlite3
ExecStartPre=/usr/local/lib/bell/wait-for-time-sync.sh
ExecStart=/usr/bin/node /opt/bell/site/index.js
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bell

[Install]
WantedBy=multi-user.target
