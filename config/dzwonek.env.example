# Create /etc/bell/dzwonek.env on the Raspberry Pi with unique random values.
# Keep that real file out of Git and readable only by root (chmod 600).
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
JWT_SIGNING_KEY=replace-with-a-different-unique-random-secret
DJANGO_ALLOWED_HOSTS=bell.local,localhost,127.0.0.1
